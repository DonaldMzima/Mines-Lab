{
  "manifest_version": 3,
  "name": "Mines Lab Game Presence Companion",
  "version": "0.1.0",
  "description": "Detects an explicitly permitted 1win Mines tab without reading game or account data.",
  "permissions": ["tabs"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://mines-lab-nine.vercel.app/*"
  ],
  "optional_host_permissions": ["https://*.1win.com/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Mines Lab Companion",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "https://mines-lab-nine.vercel.app/*"
      ],
      "js": ["app-bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://*.1win.com/*"],
      "js": ["game-probe.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
